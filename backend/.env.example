NODE_ENV=development
PORT=5000
LOG_LEVEL=info
TRUST_PROXY=false

# Database
# Local example: mongodb://127.0.0.1:27017/Toki
# Atlas example: mongodb+srv://<username>:<password>@<cluster-url>/Toki
MONGODB_URI=

# Auth
# Use a long random secret. Do not commit the real value.
JWT_SECRET=

# Frontend origins allowed by CORS and Socket.IO.
# Use a comma-separated list for multiple deployed frontends.
# Local: http://localhost:5173
# Production same-domain: https://your-app.onrender.com
# Production split frontend/backend: https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# JWT cookie behavior.
# Local dev: COOKIE_SECURE=false and COOKIE_SAME_SITE=lax
# Cross-domain production frontend/backend: COOKIE_SECURE=true and COOKIE_SAME_SITE=none
# Same-domain production: COOKIE_SECURE=true and COOKIE_SAME_SITE=lax is stricter.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Resend API
# Sender must be verified in Resend for production email delivery.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Cloudinary API
# Values come from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Arcjet
# Use DRY_RUN while tuning rules, LIVE when ready to enforce in production.
ARCJET_KEY=
ARCJET_MODE=DRY_RUN

# Upload limits
# JSON_BODY_LIMIT should be large enough for base64 image payload overhead.
MAX_IMAGE_UPLOAD_BYTES=5242880
JSON_BODY_LIMIT=10mb
